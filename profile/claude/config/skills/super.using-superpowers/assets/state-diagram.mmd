    class ChecandoPreferencias,GateQA,GateDisjuncao,VerificacaoIndependente,RegistrandoLicao gate
    class Triagem,PerguntaDeAbertura,EscolhendoModo,ApresentandoOpcoes,DecideCorrecao hub
    class Pesquisando,Explorando,Formalizando,Planejando,Executando,Finalizando nominal
    class RevisandoSpec,Onboarding optional
    class ModoSequencial execSeq
    class ModoParaleloInTree execIT
    class ModoParalelo execWT
    class ModoInline execInline
    class Depurando,DepurandoExec,DepurandoExecIT,DepurandoExecP,QuestionandoArquitetura,Investigando,Analisando,Corrigindo,Reprovado,CorrigindoInline debug
    class Merge,PullRequest,Manter,Descartar terminal
